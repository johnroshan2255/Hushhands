  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.10",
    "@colyseus/schema": "^5.0.50",
    "@colyseus/ws-transport": "^0.18.1",
    "colyseus": "^0.18.1",
    "playcanvas": "^2.24.2"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=20"
  }
