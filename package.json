{
  "name": "threadbearers",
  "version": "0.1.0",
  "description": "One thread, up to four small wanderers, a dark loom to cross (PlayCanvas + Colyseus)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "server": "node server/index.js",
    "play": "vite build && node server/index.js",
